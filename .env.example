# Primary storage (recommended on Vercel): Neon / Postgres
# Use .env.local for local development. Keep real secrets out of this tracked file.
DATABASE_URL=
# Optional alias if your integration provides this name
POSTGRES_URL=

# Optional lead delivery destinations
# If set, lead JSON will be POSTed to this endpoint (Google Sheets Apps Script, Zapier, etc.)
LEAD_WEBHOOK_URL=

# Admin notification destination
ADMIN_NOTIFICATION_EMAIL=

# Email provider option 1: Resend
RESEND_API_KEY=
ADMIN_NOTIFICATION_FROM=

# Email provider option 2: SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=

# Admin dashboard protection (Basic Auth) for /admin/* and /api/admin/*
# Required in production
ADMIN_USERNAME=
ADMIN_PASSWORD=
